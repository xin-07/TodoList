<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>TodoList</RootNamespace>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- 单文件发布：仅当显式指定 RuntimeIdentifier 时生效，避免破坏无 RID 的普通发布。
       IncludeNativeLibrariesForSelfExtract 把 SQLite 原生库一并打进单文件，运行时才临时解压。 -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
  </ItemGroup>

  <!-- 测试工程位于子目录 Tests/，默认 SDK 递归 glob 会把它误编译进主工程，故显式排除。 -->
  <ItemGroup>
    <Compile Remove="Tests\**\*.cs" />
    <None Remove="Tests\**" />
  </ItemGroup>

  <!-- 窗口标题栏图标资源：app.ico 由 Assets/app.svg（唯一权威源）生成，仅嵌入 ico。 -->
  <ItemGroup>
    <AvaloniaResource Include="Assets\app.ico" />
  </ItemGroup>
</Project>
