<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:TodoList.ViewModels"
        xmlns:models="using:TodoList.Models"
        xmlns:c="using:Avalonia.Data.Converters"
        mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="440"
        x:Class="TodoList.MainWindow"
        x:Name="Root"
        x:DataType="vm:MainWindowViewModel"
        Title="TodoList"
        Icon="/Assets/app.ico"
        Width="760" Height="440"
        MinWidth="740"
        WindowStartupLocation="CenterScreen">

    <Window.Styles>
        <!-- 优先级高亮条 -->
        <Style Selector="Border.priBar.high">
            <Setter Property="Background" Value="#D84315" />
        </Style>
        <Style Selector="Border.priBar.medium">
            <Setter Property="Background" Value="#FB8C00" />
        </Style>
        <Style Selector="Border.priBar.low">
            <Setter Property="Background" Value="#0288D1" />
        </Style>
        <Style Selector="Border.priBar.none">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- 截止日期到期提示：与上方选择框同对齐（选择框居中则提示居中，靠左则靠左） -->
        <Style Selector="TextBlock.dueText">
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.dueText.hasDue">
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <!-- 截止日期到期高亮 -->
        <Style Selector="TextBlock.dueText.overdue">
            <Setter Property="Foreground" Value="Red" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="TextBlock.dueText.dueToday">
            <Setter Property="Foreground" Value="#FB8C00" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <!-- 校验错误提示 -->
        <Style Selector="TextBlock.error">
            <Setter Property="Foreground" Value="Red" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <!-- 截止日期纯选择框按钮样式：无到期提示时水平居中，有提示时靠左 -->
        <Style Selector="Button.dueSelect">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="Button.dueSelect.hasDue">
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style Selector="TextBlock.dueSelectText">
            <Setter Property="Foreground" Value="Gray" />
        </Style>
        <Style Selector="TextBlock.dueSelectText.set">
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        </Style>

        <!-- 列头样式 -->
        <Style Selector="TextBlock.header">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        </Style>
    </Window.Styles>

    <Grid Margin="16" PointerPressed="OnRootPointerPressed">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧：文件夹边栏 -->
        <DockPanel Grid.Column="0" Margin="0,0,16,0">
            <TextBlock DockPanel.Dock="Top"
                       Text="文件夹"
                       Classes="header"
                       Margin="0,0,0,6" />

            <!-- 文件夹列表：与"新建文件夹"入口作为一个滚动整体，入口紧跟未归类项下方 -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="6">
                    <ListBox ItemsSource="{Binding SidebarItems}"
                             SelectedItem="{Binding SelectedSidebar}"
                             SelectionChanged="OnSidebarSelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:SidebarItemViewModel">
                                <Grid>
                                    <!-- 重命名态 -->
                                    <StackPanel Orientation="Horizontal" Spacing="6"
                                                IsVisible="{Binding IsRenaming}">
                                        <TextBox Text="{Binding EditText, Mode=TwoWay}"
                                                 KeyDown="OnFolderRenameKeyDown"
                                                 LostFocus="OnFolderRenameLostFocus" />
                                        <Button Content="✓" Foreground="Green" Background="Transparent"
                                                Command="{Binding SaveRenameCommand}" />
                                    </StackPanel>

                                    <!-- 常规展示态 -->
                                    <Grid ColumnDefinitions="*,Auto,Auto"
                                      IsVisible="{Binding IsNotRenaming}">
                                        <TextBlock Grid.Column="0"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding Name}"
                                                   Margin="0,0,6,0"
                                                   ToolTip.Tip="{Binding Name}"
                                                   Background="Transparent"
                                                   Focusable="True"
                                                   DoubleTapped="OnFolderNameDoubleTapped" />
                                        <TextBlock Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   Foreground="Gray"
                                                   Text="{Binding ItemCount}"
                                                   Margin="0,0,6,0" />
                                        <!-- 文件夹专属：删除 -->
                                        <Button Grid.Column="2"
                                                Background="Transparent"
                                                Padding="4,0"
                                                ToolTip.Tip="删除文件夹"
                                                IsVisible="{Binding IsFolder}"
                                                Command="{Binding $parent[Window].DataContext.DeleteFolderCommand}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="🗑"
                                                       Foreground="Red"
                                                       FontSize="12"
                                                       VerticalAlignment="Center" />
                                        </Button>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 新建文件夹：命名输入（点击下方按钮后展开） -->
                    <DockPanel x:Name="NewFolderInput" IsVisible="{Binding IsNewFolderOpen}">
                        <Button DockPanel.Dock="Right"
                                Margin="6,0,0,0"
                                Content="确认"
                                Command="{Binding AddFolderCommand}" />
                        <TextBox Watermark="输入文件夹名称..."
                                 Text="{Binding NewFolderName, Mode=TwoWay}"
                                 KeyDown="OnNewFolderKeyDown"
                                 LostFocus="OnNewFolderLostFocus" />
                        <TextBlock DockPanel.Dock="Bottom"
                                   Text="{Binding AddFolderError}"
                                   Classes="error"
                                   IsVisible="{Binding AddFolderError, Converter={x:Static c:StringConverters.IsNotNullOrEmpty}}"
                                   Margin="0,2,0,0" />
                    </DockPanel>

                    <!-- 长方形新建按钮 -->
                    <Button Content="＋ 新建文件夹"
                            HorizontalAlignment="Stretch"
                            Command="{Binding ToggleNewFolderCommand}" />
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <!-- 右侧：任务区 -->
        <DockPanel Grid.Column="1">

            <!-- 顶部：输入 + 添加 -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <Button DockPanel.Dock="Right"
                        Margin="8,0,0,0"
                        Content="添加"
                        Command="{Binding AddTaskCommand}" />
                <TextBox Watermark="输入关键字搜索已有任务，或输入新任务，回车添加..."
                         Text="{Binding NewTaskTitle, Mode=TwoWay}"
                         KeyDown="OnNewTaskKeyDown" />
            </DockPanel>

            <!-- 新增标题校验错误 -->
            <TextBlock DockPanel.Dock="Top"
                       Text="{Binding AddError}"
                       Classes="error"
                       IsVisible="{Binding AddError, Converter={x:Static c:StringConverters.IsNotNullOrEmpty}}"
                       Margin="0,-6,0,8" />

            <!-- 底部：统计 -->
            <TextBlock DockPanel.Dock="Bottom"
                       Margin="0,12,0,0"
                       HorizontalAlignment="Center"
                       Foreground="Gray"
                       Text="{Binding StatsText}" />

            <!-- 中部：列对齐的表头
                 Width 绑定列表滚动区的实际内容宽度（Extent.Width = 视口宽 - 竖向滚动条宽），
                 使表头与列表行共用同一套列宽；否则列表出现滚动条时比例列会整体错位。
                 MinWidth 仅作为绑定尚未求值时的兜底下限，正常窗口宽度下不会生效。 -->
            <Border DockPanel.Dock="Top"
                    Margin="0,0,0,6"
                    Padding="0,0,0,4"
                    MinWidth="200"
                    Width="{Binding #TaskListScroll.Extent.Width}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                    BorderThickness="0,0,0,1">
                <!-- 列定义必须与下方任务行 Grid 保持一致：比例列随窗口宽度伸缩，MinWidth 是控件可读性下限。
                     下限合计 = 4(高亮条)+40(勾选)+80+96+76+118+56 = 470px，加上侧栏与外边距 222px，
                     得出窗口 MinWidth=740；调整任一 MinWidth 时必须同步复核窗口下限，否则窄窗口会再次溢出裁剪。 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="2*" MinWidth="80" />
                        <ColumnDefinition Width="1.4*" MinWidth="96" />
                        <ColumnDefinition Width="1*" MinWidth="76" />
                        <ColumnDefinition Width="1.6*" MinWidth="118" />
                        <ColumnDefinition Width="0.6*" MinWidth="56" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" />
                    <TextBlock Grid.Column="1" Text="完成"
                               Classes="header" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="标题"
                               Classes="header" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="文件夹"
                               Classes="header" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="4" Text="优先级"
                               Classes="header" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="5" Text="截止日期"
                               Classes="header" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="6" Text="操作"
                               Classes="header" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Grid>
            </Border>

            <!-- 中部：任务列表（网格化行，列与表头对齐；内容超出窗口高度时上下滚动） -->
            <ScrollViewer x:Name="TaskListScroll" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding DisplayItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TodoItemViewModel">
                        <!-- 列定义必须与上方表头 Grid 保持一致 -->
                        <Grid Margin="0,3"
                              Opacity="{Binding RowOpacity}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="2*" MinWidth="80" />
                                <ColumnDefinition Width="1.4*" MinWidth="96" />
                                <ColumnDefinition Width="1*" MinWidth="76" />
                                <ColumnDefinition Width="1.6*" MinWidth="118" />
                                <ColumnDefinition Width="0.6*" MinWidth="56" />
                            </Grid.ColumnDefinitions>
                            <!-- 优先级高亮条 -->
                            <Border Grid.Column="0"
                                    Classes="priBar"
                                    Classes.high="{Binding IsHigh}"
                                    Classes.medium="{Binding IsMedium}"
                                    Classes.low="{Binding IsLow}"
                                    Classes.none="{Binding IsNone}" />

                            <!-- 完成 -->
                            <CheckBox Grid.Column="1"
                                      IsChecked="{Binding IsCompleted, Mode=TwoWay}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />

                            <!-- 标题：展示或原地编辑 -->
                            <Grid Grid.Column="2" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <!-- 展示/编辑二选一：用 Panel 而非水平 StackPanel，
                                     StackPanel 会给子元素无限宽度，导致标题永不换行。 -->
                                <Panel>
                                    <TextBlock Text="{Binding Title}"
                                               Background="Transparent"
                                               Focusable="True"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding IsNotEditing}"
                                               DoubleTapped="OnTitleDoubleTapped"
                                               KeyDown="OnTitleKeyDown" />
                                    <TextBox Text="{Binding EditText, Mode=TwoWay}"
                                             VerticalAlignment="Center"
                                             IsVisible="{Binding IsEditing}"
                                             KeyDown="OnEditKeyDown"
                                             LostFocus="OnEditLostFocus" />
                                </Panel>
                                <TextBlock Grid.Row="1"
                                           Text="{Binding EditError}"
                                           Classes="error"
                                           IsVisible="{Binding EditError, Converter={x:Static c:StringConverters.IsNotNullOrEmpty}}" />
                            </Grid>

                            <!-- 文件夹：归属下拉。列宽随窗口伸缩；超长文件夹名显示省略号，悬停显示全名 -->
                            <ComboBox Grid.Column="3"
                                      Margin="0,0,8,0"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Center"
                                      ToolTip.Tip="{Binding SelectedFolder.Name}"
                                      ItemsSource="{Binding FolderChoices}"
                                      SelectedItem="{Binding SelectedFolder}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SidebarItemViewModel">
                                        <TextBlock Text="{Binding Name}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip.Tip="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <!-- 优先级 -->
                            <ComboBox Grid.Column="4"
                                      Margin="0,0,8,0"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Center"
                                      ItemsSource="{Binding PriorityOptions}"
                                      SelectedItem="{Binding Priority}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PriorityOption">
                                        <TextBlock Text="{Binding Label}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <!-- 截止日期：到期提示固定放在选择框正下方（上下两行），
                                 避免左右分布时窄列下右对齐提示向左溢出、压到选择框上 -->
                            <Grid Grid.Column="5" Margin="0,0,4,0" VerticalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Button Classes="dueSelect"
                                        Classes.hasDue="{Binding HasDueText}"
                                        MinWidth="110"
                                        VerticalAlignment="Center"
                                        ToolTip.Tip="点击选择截止日期">
                                    <Button.Flyout>
                                        <Flyout Placement="Bottom">
                                            <StackPanel Spacing="6">
                                                <!-- 按年翻页栏（双箭头 « / »） -->
                                                <Grid ColumnDefinitions="Auto,*,Auto" Margin="4,2">
                                                    <Button Grid.Column="0"
                                                            Content="«"
                                                            Padding="6,2"
                                                            FontWeight="Bold"
                                                            ToolTip.Tip="上一年"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Command="{Binding PrevYearCommand}" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="按年切换"
                                                               Foreground="Gray"
                                                               FontSize="11"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                    <Button Grid.Column="2"
                                                            Content="»"
                                                            Padding="6,2"
                                                            FontWeight="Bold"
                                                            ToolTip.Tip="下一年"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Command="{Binding NextYearCommand}" />
                                                </Grid>

                                                <!-- 日历月历格子（含唯一一组按月翻页键与年月标题） -->
                                                <Calendar SelectedDate="{Binding DueDateSelectedDate, Mode=TwoWay}"
                                                          DisplayDate="{Binding DisplayDate, Mode=TwoWay}"
                                                          DisplayDateStart="1979-01-01" />

                                                <!-- 清空按钮：平时不显示，仅在用户已选择截止日期后显示 -->
                                                <Button Content="清空截止日期"
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Center"
                                                        IsVisible="{Binding IsDueDateSet}"
                                                        Command="{Binding ClearDueDateCommand}" />
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
                                        <TextBlock Text="{Binding DueDateDisplayText}"
                                                   Classes="dueSelectText"
                                                   Classes.set="{Binding IsDueDateSet}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="🗓"
                                                   FontSize="11"
                                                   Foreground="Gray"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Grid.Row="1"
                                           Text="{Binding DueText}"
                                           Classes="dueText"
                                           Classes.hasDue="{Binding HasDueText}"
                                           Classes.overdue="{Binding IsOverdue}"
                                           Classes.dueToday="{Binding IsDueToday}"
                                           IsVisible="{Binding DueText, Converter={x:Static c:StringConverters.IsNotNullOrEmpty}}" />
                                <TextBlock Grid.Row="2"
                                           Text="{Binding DueDateError}"
                                           Classes="error"
                                           IsVisible="{Binding DueDateError, Converter={x:Static c:StringConverters.IsNotNullOrEmpty}}" />
                            </Grid>

                            <!-- 删除 -->
                            <Button Grid.Column="6"
                                    Content="删除"
                                    HorizontalAlignment="Stretch"
                                    Foreground="Red"
                                    Background="Transparent"
                                    Command="{Binding $parent[Window].DataContext.RemoveTaskCommand}"
                                    CommandParameter="{Binding}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

        </DockPanel>
    </Grid>
</Window>